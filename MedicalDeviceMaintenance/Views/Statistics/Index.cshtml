@{
    ViewData["Title"] = "Statistics";
}

<div class="hero-banner" style="background-image: url('~/images/statistics-hero.jpg');">
    <div class="hero-content">
        <h1>Statistics</h1>
        <p>Trends across devices, incidents and maintenance activity.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-1">
            <div class="stat-value">@ViewBag.TotalDevices</div>
            <div class="stat-label">Total devices</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-2">
            <div class="stat-value" style="color: var(--color-danger);">@ViewBag.TotalIncidents</div>
            <div class="stat-label">Total incidents</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-3">
            <div class="stat-value" style="color: var(--color-primary);">@ViewBag.TotalMaintenanceActions</div>
            <div class="stat-label">Maintenance actions</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-4">
            <div class="stat-value" style="color: var(--color-warning);">@ViewBag.AvgIncidentsPerDevice</div>
            <div class="stat-label">Avg incidents / device</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6 fade-in fade-in-1">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-stethoscope me-2" style="color: var(--color-primary);"></i>
                Devices by status
            </div>
            <div class="card-body">
                <canvas id="deviceStatusChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6 fade-in fade-in-2">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-triangle-exclamation me-2" style="color: var(--color-danger);"></i>
                Incidents by severity
            </div>
            <div class="card-body">
                <canvas id="severityChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-7 fade-in fade-in-3">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-chart-line me-2" style="color: var(--color-primary);"></i>
                Incidents reported — last 6 months
            </div>
            <div class="card-body">
                <canvas id="monthlyChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5 fade-in fade-in-4">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-wrench me-2" style="color: var(--color-primary);"></i>
                Actions by technician
            </div>
            <div class="card-body">
                <canvas id="technicianChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        const navy = '#0F2A4A';
        const amber = '#F2B84B';
        const success = '#3E7F52';
        const warning = '#B96D22';
        const danger = '#A63E30';
        const muted = '#756F5D';

        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = muted;

        new Chart(document.getElementById('deviceStatusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.DeviceStatusLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.DeviceStatusData)),
                    backgroundColor: [success, warning, danger, navy, muted],
                    borderWidth: 0
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } }
            }
        });

        new Chart(document.getElementById('severityChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.SeverityLabels)),
                datasets: [{
                    label: 'Incidents',
                    data: @Html.Raw(Json.Serialize(ViewBag.SeverityData)),
                    backgroundColor: [danger, warning, navy, '#8FA4C2'],
                    borderRadius: 6
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        new Chart(document.getElementById('monthlyChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.MonthlyLabels)),
                datasets: [{
                    label: 'Incidents reported',
                    data: @Html.Raw(Json.Serialize(ViewBag.MonthlyData)),
                    borderColor: navy,
                    backgroundColor: 'rgba(15,42,74,0.08)',
                    fill: true,
                    tension: 0.3,
                    pointBackgroundColor: amber,
                    pointRadius: 4
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        new Chart(document.getElementById('technicianChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.TechnicianLabels)),
                datasets: [{
                    label: 'Actions logged',
                    data: @Html.Raw(Json.Serialize(ViewBag.TechnicianData)),
                    backgroundColor: amber,
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}
