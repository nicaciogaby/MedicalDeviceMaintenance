@{
    ViewData["Title"] = "Dashboard";
}
<!-- Hero -->
<div class="hero-banner" style="background-image: url('/images/login-hero.jpg');">
    <div class="hero-content d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <h1>Dashboard</h1>
            <p>
                <i class="fa-regular fa-calendar me-1"></i>
                @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Devices" asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus me-1"></i>Add device
            </a>
            <a asp-controller="Incidents" asp-action="Create" class="btn btn-outline-light">
                <i class="fa-solid fa-triangle-exclamation me-1"></i>Report incident
            </a>
        </div>
    </div>
</div>
<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3 fade-in fade-in-1">
        <div class="card stat-card h-100">
            <i class="fa-solid fa-stethoscope stat-icon"></i>
            <div class="stat-value" id="countTotal">@(ViewBag.TotalDevices ?? 0)</div>
            <div class="stat-label">Total devices</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 fade-in fade-in-2">
        <div class="card stat-card h-100">
            <i class="fa-solid fa-circle-check stat-icon"></i>
            <div class="stat-value" id="countActive" style="color: var(--color-success);">@(ViewBag.ActiveDevices ?? 0)</div>
            <div class="stat-label">Active devices</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 fade-in fade-in-3">
        <div class="card stat-card h-100">
            <i class="fa-solid fa-wrench stat-icon"></i>
            <div class="stat-value" id="countMaintenance" style="color: var(--color-warning);">@(ViewBag.MaintenanceDevices ?? 0)</div>
            <div class="stat-label">In maintenance</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 fade-in fade-in-4">
        <div class="card stat-card h-100">
            <i class="fa-solid fa-triangle-exclamation stat-icon"></i>
            <div class="stat-value" id="countIncidents" style="color: var(--color-danger);">@(ViewBag.OpenIncidents ?? 0)</div>
            <div class="stat-label">Open incidents</div>
        </div>
    </div>
</div>
<!-- Recent Incidents + Quick Links -->
<div class="row g-3">
    <!-- Recent Incidents Table -->
    <div class="col-lg-8 fade-in fade-in-2">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="fa-solid fa-clock-rotate-left me-2" style="color: var(--color-primary);"></i>
                    Recent incidents
                </span>
                <a asp-controller="Incidents" asp-action="Index"
                   class="btn btn-sm btn-outline-primary">View all</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentIncidents == null || ((IEnumerable<MedicalDeviceMaintenance.Models.Incident>)ViewBag.RecentIncidents).Count() == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-circle-check fa-2x mb-2" style="color: var(--color-success);"></i>
                        <p class="mb-0">No incidents recorded.</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Device</th>
                                <th>Severity</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var incident in (IEnumerable<MedicalDeviceMaintenance.Models.Incident>)ViewBag.RecentIncidents)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Incidents" asp-action="Details"
                                           asp-route-id="@incident.Id" class="text-decoration-none fw-500">
                                            @incident.Title
                                        </a>
                                    </td>
                                    <td class="text-muted">@incident.Device?.Name</td>
                                    <td>
                                        <span class="badge @(incident.Severity == "Critical" || incident.Severity == "High" ? "bg-danger" :
                                                                                                                                                         incident.Severity == "Medium" ? "bg-warning" : "bg-info")">
                                    @incident.Severity
                                </span>
                            </td>
                            <td>
                                <span class="badge @(incident.Status == "Open" ? "bg-danger" :
                                                                                                                                         incident.Status == "In Progress" ? "bg-warning" : "bg-success")">
                                    @incident.Status
                                </span>
                            </td>
                            <td class="text-muted small">
                                @incident.DateReported.ToShortDateString()
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <!-- Quick Links -->
    <div class="col-lg-4 fade-in fade-in-3">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-bolt me-2" style="color: var(--color-primary);"></i>Quick actions
            </div>
            <div class="card-body">
                <div class="quick-link-grid">
                    <a asp-controller="Devices" asp-action="Index" class="quick-link-tile">
                        <i class="fa-solid fa-stethoscope"></i>
                        Manage devices
                    </a>
                    <a asp-controller="Devices" asp-action="Create" class="quick-link-tile">
                        <i class="fa-solid fa-plus"></i>
                        Add device
                    </a>
                    <a asp-controller="Incidents" asp-action="Index" class="quick-link-tile">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        View incidents
                    </a>
                    <a asp-controller="Incidents" asp-action="Create" class="quick-link-tile">
                        <i class="fa-solid fa-file-circle-plus"></i>
                        Report incident
                    </a>
                    <a asp-controller="MaintenanceActions" asp-action="Index" class="quick-link-tile">
                        <i class="fa-solid fa-wrench"></i>
                        View maintenance
                    </a>
                    <a asp-controller="MaintenanceActions" asp-action="Create" class="quick-link-tile">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        Log maintenance
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Animate stat numbers counting up
        function animateCount(elementId, target) {
            const el = document.getElementById(elementId);
            if (!el) return;
            let current = 0;
            const duration = 800;
            const step = Math.ceil(target / (duration / 16)) || 1;
            const timer = setInterval(() => {
                current += step;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                el.textContent = current;
            }, 16);
        }
        document.addEventListener('DOMContentLoaded', () => {
            animateCount('countTotal',      @(ViewBag.TotalDevices ?? 0));
            animateCount('countActive',     @(ViewBag.ActiveDevices ?? 0));
            animateCount('countMaintenance',@(ViewBag.MaintenanceDevices ?? 0));
            animateCount('countIncidents',  @(ViewBag.OpenIncidents ?? 0));
        });
    </script>
}