@model IEnumerable<MedicalDeviceMaintenance.Models.Incident>
@{
    ViewData["Title"] = "Incidents";
    var total = Model.Count();
    var open = Model.Count(i => i.Status == "Open");
    var inProgress = Model.Count(i => i.Status == "In Progress");
    var critical = Model.Count(i => i.Severity == "Critical" || i.Severity == "High");
}

<div class="hero-banner" style="background-image: url('~/images/incidents-hero.jpg');">
    <div class="hero-content">
        <h1>Incidents</h1>
        <p>Report, track and resolve equipment issues across the facility.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-1">
            <div class="stat-value">@total</div>
            <div class="stat-label">Total incidents</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-2">
            <div class="stat-value" style="color: var(--color-danger);">@open</div>
            <div class="stat-label">Open</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-3">
            <div class="stat-value" style="color: var(--color-warning);">@inProgress</div>
            <div class="stat-label">In progress</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-4">
            <div class="stat-value" style="color: var(--color-primary);">@critical</div>
            <div class="stat-label">High / critical</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0 text-muted">Incident list</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Technician"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-file-circle-plus me-1"></i>Report new incident
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center fade-in">
        <i class="fa-solid fa-circle-check mb-3" style="font-size: 2.5rem; color: var(--color-success);"></i>
        <p class="text-muted mb-0">No incidents recorded. Click "Report new incident" to get started.</p>
    </div>
}
else
{
    <div class="card fade-in fade-in-2">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th>@Html.DisplayNameFor(model => model.Severity)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th>@Html.DisplayNameFor(model => model.DateReported)</th>
                    <th>Device</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Title)</td>
                        <td class="text-muted">
                            @if (item.Description.Length > 50)
                            {
                                @item.Description.Substring(0, 50)
                                <text>...</text>
                            }
                            else
                            {
                                @item.Description
                            }
                        </td>
                        <td>
                            <span class="badge @(item.Severity == "Critical" || item.Severity == "High" ? "bg-danger" :
                                                                                      item.Severity == "Medium" ? "bg-warning" : "bg-info")">
                        @item.Severity
                    </span>
                </td>
                <td>
                    <span class="badge @(item.Status == "Open" ? "bg-danger" :
                                                                              item.Status == "In Progress" ? "bg-warning" : "bg-success")">
                        @item.Status
                    </span>
                </td>
                <td class="text-muted small">@item.DateReported.ToShortDateString()</td>
                <td>
                    <a asp-controller="Devices" asp-action="Details"
                       asp-route-id="@item.DeviceId">
                        @Html.DisplayFor(modelItem => item.Device.Name)
                    </a>
                </td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary me-1">Details</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Technician"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
