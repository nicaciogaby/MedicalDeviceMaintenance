@model MedicalDeviceMaintenance.Models.Incident
@{
    ViewData["Title"] = "Incident Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="fa-solid fa-triangle-exclamation me-2" style="color: var(--color-danger); opacity: 0.8;"></i>
        @Model.Title
    </h1>
    <div class="d-flex gap-2">
        <span class="badge @(Model.Severity == "Critical" || Model.Severity == "High" ? "bg-danger" :
                                           Model.Severity == "Medium" ? "bg-warning" : "bg-info") fs-6">
            @Html.DisplayFor(model => model.Severity)
        </span>
        <span class="badge @(Model.Status == "Open" ? "bg-danger" :
                                           Model.Status == "In Progress" ? "bg-warning" : "bg-success") fs-6">
            @Html.DisplayFor(model => model.Status)
        </span>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5 fade-in fade-in-1">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-circle-info me-2" style="color: var(--color-primary);"></i>
                Incident information
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.Description)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.DateReported)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.DateReported)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.Device)</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Devices" asp-action="Details" asp-route-id="@Model.DeviceId">
                            @Html.DisplayFor(model => model.Device.Name)
                        </a>
                    </dd>
                </dl>

                <div class="d-flex gap-2 mt-4 pt-3" style="border-top: 1px solid var(--color-border);">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                        <i class="fa-solid fa-pen me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7 fade-in fade-in-2">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="fa-solid fa-wrench me-2" style="color: var(--color-primary);"></i>
                    Maintenance actions
                </span>
                <a asp-controller="MaintenanceActions" asp-action="Create"
                   class="btn btn-sm btn-success">
                    <i class="fa-solid fa-plus me-1"></i>Add action
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.MaintenanceActions == null || !Model.MaintenanceActions.Any())
                {
                    <p class="text-muted p-4 mb-0">No maintenance actions recorded for this incident.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Action taken</th>
                                <th>Technician</th>
                                <th>Date</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var action in Model.MaintenanceActions)
                            {
                                <tr>
                                    <td>@action.ActionTaken</td>
                                    <td>@action.TechnicianName</td>
                                    <td class="text-muted small">@action.ActionDate.ToShortDateString()</td>
                                    <td class="text-muted">@action.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
