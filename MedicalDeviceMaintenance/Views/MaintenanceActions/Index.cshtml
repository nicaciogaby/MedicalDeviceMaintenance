@model IEnumerable<MedicalDeviceMaintenance.Models.MaintenanceAction>
@{
    ViewData["Title"] = "Maintenance Actions";
    var total = Model.Count();
    var last30 = Model.Count(m => m.ActionDate >= DateTime.Now.AddDays(-30));
    var technicians = Model.Select(m => m.TechnicianName).Distinct().Count();
}

<div class="hero-banner" style="background-image: url('~/images/maintenance-hero.jpg');">
    <div class="hero-content">
        <h1>Maintenance actions</h1>
        <p>A log of every repair, inspection and service performed on tracked equipment.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="card stat-card fade-in fade-in-1">
            <div class="stat-value">@total</div>
            <div class="stat-label">Total actions logged</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card stat-card fade-in fade-in-2">
            <div class="stat-value" style="color: var(--color-success);">@last30</div>
            <div class="stat-label">Last 30 days</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card stat-card fade-in fade-in-3">
            <div class="stat-value" style="color: var(--color-primary);">@technicians</div>
            <div class="stat-label">Technicians involved</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0 text-muted">Action log</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Technician"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i>Log new action
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center fade-in">
        <i class="fa-solid fa-wrench mb-3" style="font-size: 2.5rem; color: var(--color-border);"></i>
        <p class="text-muted mb-0">No maintenance actions recorded yet. Click "Log new action" to get started.</p>
    </div>
}
else
{
    <div class="card fade-in fade-in-2">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.ActionTaken)</th>
                    <th>@Html.DisplayNameFor(model => model.TechnicianName)</th>
                    <th>@Html.DisplayNameFor(model => model.ActionDate)</th>
                    <th>Incident</th>
                    <th>Device</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.ActionTaken.Length > 50)
                            {
                                @item.ActionTaken.Substring(0, 50)
                                <text>...</text>
                            }
                            else
                            {
                                @item.ActionTaken
                            }
                        </td>
                        <td class="fw-semibold">@Html.DisplayFor(modelItem => item.TechnicianName)</td>
                        <td class="text-muted small">@item.ActionDate.ToShortDateString()</td>
                        <td>
                            <a asp-controller="Incidents" asp-action="Details"
                               asp-route-id="@item.IncidentId" class="text-decoration-none">
                                @Html.DisplayFor(modelItem => item.Incident.Title)
                            </a>
                        </td>
                        <td>
                            <a asp-controller="Devices" asp-action="Details"
                               asp-route-id="@item.Incident.DeviceId" class="text-decoration-none">
                                @Html.DisplayFor(modelItem => item.Incident.Device.Name)
                            </a>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary me-1">Details</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Technician"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
