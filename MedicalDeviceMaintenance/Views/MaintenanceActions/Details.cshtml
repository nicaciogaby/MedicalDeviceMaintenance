@model MedicalDeviceMaintenance.Models.MaintenanceAction
@{
    ViewData["Title"] = "Maintenance Action Details";
}

<h1 class="mb-4">
    <i class="fa-solid fa-wrench me-2" style="color: var(--color-primary); opacity: 0.7;"></i>
    Maintenance action
</h1>

<div class="row">
    <div class="col-lg-7 fade-in">
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-circle-info me-2" style="color: var(--color-primary);"></i>
                Action information
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.Incident)</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Incidents" asp-action="Details" asp-route-id="@Model.IncidentId">
                            @Html.DisplayFor(model => model.Incident.Title)
                        </a>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-500">Device</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Devices" asp-action="Details" asp-route-id="@Model.Incident.DeviceId">
                            @Html.DisplayFor(model => model.Incident.Device.Name)
                        </a>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.ActionTaken)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.ActionTaken)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.TechnicianName)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.TechnicianName)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.ActionDate)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.ActionDate)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.Notes)</dt>
                    <dd class="col-sm-8 text-muted">@(Model.Notes ?? "No notes recorded")</dd>
                </dl>

                <div class="d-flex gap-2 mt-4 pt-3" style="border-top: 1px solid var(--color-border);">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                        <i class="fa-solid fa-pen me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
                </div>
            </div>
        </div>
    </div>
</div>
