@model MedicalDeviceMaintenance.Models.MaintenanceAction
@{
    ViewData["Title"] = "Log Maintenance Action";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <h1 class="mb-0">Log maintenance action</h1>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card fade-in">
            <div class="card-header">
                <i class="fa-solid fa-wrench me-2" style="color: var(--color-primary);"></i>
                Action details
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="IncidentId" class="form-label"></label>
                            <select asp-for="IncidentId" class="form-select" asp-items="ViewBag.IncidentId">
                                <option value="">-- Select incident --</option>
                            </select>
                            <span asp-validation-for="IncidentId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ActionTaken" class="form-label"></label>
                            <textarea asp-for="ActionTaken" class="form-control" rows="4"
                                      placeholder="Describe what maintenance was performed"></textarea>
                            <span asp-validation-for="ActionTaken" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TechnicianName" class="form-label"></label>
                            <input asp-for="TechnicianName" class="form-control"
                                   placeholder="Enter technician full name" />
                            <span asp-validation-for="TechnicianName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="Any additional notes (optional)"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3" style="border-top: 1px solid var(--color-border);">
                        <input type="submit" value="Save maintenance action" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
