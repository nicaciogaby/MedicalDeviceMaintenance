@model MedicalDeviceMaintenance.Models.EditRoleViewModel
@{
    ViewData["Title"] = "Change User Role";
}

<h1 class="mb-4">Change user role</h1>

<div class="row">
    <div class="col-lg-6">
        <div class="card fade-in">
            <div class="card-header">
                <i class="fa-solid fa-user-pen me-2" style="color: var(--color-primary);"></i>
                Editing role for <span class="fw-500">@Model.Email</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditRole" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label class="form-label">Select new role</label>
                        <select asp-for="CurrentRole" class="form-select">
                            @foreach (var role in Model.AllRoles)
                            {
                                <option value="@role"
                                        selected="@(role == Model.CurrentRole)">
                                    @role
                                </option>
                            }
                        </select>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3" style="border-top: 1px solid var(--color-border);">
                        <input type="submit" value="Save role" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
