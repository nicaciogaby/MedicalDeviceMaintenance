@model IEnumerable<MedicalDeviceMaintenance.Models.UserViewModel>
@{
    ViewData["Title"] = "Admin Panel";
    var total = Model.Count();
    var admins = Model.Count(u => u.Roles.Contains("Admin"));
    var technicians = Model.Count(u => u.Roles.Contains("Technician"));
    var viewers = Model.Count(u => u.Roles.Contains("Viewer"));
}

<div class="hero-banner" style="background-image: url('~/images/admin-hero.jpg');">
    <div class="hero-content">
        <h1>Admin panel</h1>
        <p>Manage user accounts and roles across MedTracker.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-1">
            <div class="stat-value">@total</div>
            <div class="stat-label">Total users</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-2">
            <div class="stat-value" style="color: var(--color-danger);">@admins</div>
            <div class="stat-label">Admins</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-3">
            <div class="stat-value" style="color: var(--color-warning);">@technicians</div>
            <div class="stat-label">Technicians</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card fade-in fade-in-4">
            <div class="stat-value" style="color: var(--color-primary);">@viewers</div>
            <div class="stat-label">Viewers</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0 text-muted">User management</h2>
    <a asp-controller="Account" asp-action="Register" class="btn btn-success">
        <i class="fa-solid fa-user-plus me-1"></i>Add new user
    </a>
</div>

<div class="card fade-in fade-in-2">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <i class="fa-solid fa-user me-2" style="color: var(--color-text-muted);"></i>
                            @user.Email
                        </td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge @(role == "Admin" ? "bg-danger" :
                                                                                           role == "Technician" ? "bg-warning" :
                                                                                           "bg-info")">
                            @role
                        </span>
                                                }
                            @if (!user.Roles.Any())
                            {
                                <span class="badge bg-secondary">No role</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditRole" asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-primary me-1">
                                <i class="fa-solid fa-user-pen me-1"></i>Change role
                            </a>
                            <form asp-action="DeleteUser" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this user?')">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fa-solid fa-trash me-1"></i>Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
