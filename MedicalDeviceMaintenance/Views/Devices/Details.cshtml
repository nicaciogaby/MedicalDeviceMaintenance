@model MedicalDeviceMaintenance.Models.Device
@{
    ViewData["Title"] = "Device Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="fa-solid fa-stethoscope me-2" style="color: var(--color-primary); opacity: 0.7;"></i>
        @Model.Name
    </h1>
    <span class="badge @(Model.Status == "Active" ? "bg-success" :
                                   Model.Status == "Maintenance" ? "bg-warning" :
                                   "bg-danger") fs-6">
        @Html.DisplayFor(model => model.Status)
    </span>
</div>

<div class="row g-3">
    <!-- Device Information -->
    <div class="col-lg-5 fade-in fade-in-1">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-circle-info me-2" style="color: var(--color-primary);"></i>
                Device information
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.Name)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.SerialNumber)</dt>
                    <dd class="col-sm-8 mono">@Html.DisplayFor(model => model.SerialNumber)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.Model)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Model)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.Manufacturer)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Manufacturer)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.Location)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Location)</dd>

                    <dt class="col-sm-4 text-muted fw-500">@Html.DisplayNameFor(model => model.PurchaseDate)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.PurchaseDate)</dd>
                </dl>

                <div class="d-flex gap-2 mt-4 pt-3" style="border-top: 1px solid var(--color-border);">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                        <i class="fa-solid fa-pen me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Incidents + Maintenance -->
    <div class="col-lg-7 fade-in fade-in-2">
        <div class="card mb-3">
            <div class="card-header">
                <i class="fa-solid fa-triangle-exclamation me-2" style="color: var(--color-danger);"></i>
                Incidents
            </div>
            <div class="card-body p-0">
                @if (Model.Incidents == null || !Model.Incidents.Any())
                {
                    <p class="text-muted p-4 mb-0">No incidents recorded for this device.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Severity</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var incident in Model.Incidents)
                            {
                                <tr>
                                    <td>@incident.Title</td>
                                    <td>
                                        <span class="badge @(incident.Severity == "High" || incident.Severity == "Critical" ? "bg-danger" :
                                                                                                           incident.Severity == "Medium" ? "bg-warning" :
                                                                                                           "bg-info")">
                                    @incident.Severity
                                </span>
                            </td>
                            <td>@incident.Status</td>
                            <td class="text-muted small">@incident.DateReported.ToShortDateString()</td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-wrench me-2" style="color: var(--color-primary);"></i>
                Maintenance actions
            </div>
            <div class="card-body p-0">
                @if (Model.Incidents == null || !Model.Incidents.Any(i => i.MaintenanceActions != null && i.MaintenanceActions.Any()))
                {
                    <p class="text-muted p-4 mb-0">No maintenance actions recorded for this device.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Action taken</th>
                                <th>Technician</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var incident in Model.Incidents)
                            {
                                @if (incident.MaintenanceActions != null)
                                {
                                    @foreach (var action in incident.MaintenanceActions)
                                    {
                                        <tr>
                                            <td>@action.ActionTaken</td>
                                            <td>@action.TechnicianName</td>
                                            <td class="text-muted small">@action.ActionDate.ToShortDateString()</td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
